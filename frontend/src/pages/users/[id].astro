---
import Layout from '../../layouts/Layout.astro';
import { requireAdmin } from '../../lib/auth.js';
import { db } from '../../lib/db.js';
import { requireProvider, getProviderOptions } from '../../lib/providers/index.js';
import bcrypt from 'bcryptjs';

export const prerender = false;

interface DynDnsUser {
  id: number;
  username: string;
  password_hash: string;
  provider: string;
  api_key: string;
  description: string | null;
  created_at: string;
}

interface Domain {
  id: number;
  dyndns_user_id: number;
  domain: string;
  zone_id: string;
  record_name: string;
  record_id: string | null;
  last_ip: string | null;
  last_updated: string | null;
  app_created: number;
}

let admin;
try {
  admin = await requireAdmin(Astro.request);
} catch (error) {
  return Astro.redirect('/');
}

const userId = Number(Astro.params.id);
if (!userId) {
  return Astro.redirect('/dashboard');
}

let user = db.prepare('SELECT * FROM dyndns_users WHERE id = ?').get(userId) as DynDnsUser | undefined;
if (!user) {
  return Astro.redirect('/dashboard');
}

const providerOptions = getProviderOptions();
const currentProvider = requireProvider(user.provider);
const formData = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
let error = '';
let success = '';

if (formData) {
  const action = (formData.get('action') || '').toString();
  
  if (action === 'update-configuration') {
    const newUsername = (formData.get('username') || '').toString().trim();
    const password = (formData.get('password') || '').toString().trim();
    const provider = (formData.get('provider') || '').toString().trim();
    const apiKey = (formData.get('apiKey') || '').toString().trim();
    const description = (formData.get('description') || '').toString().trim();

    // Validate username
    if (!newUsername) {
      error = 'Username is required.';
    } else if (newUsername !== user.username) {
      const existing = db.prepare('SELECT id FROM dyndns_users WHERE username = ? AND id != ?').get(newUsername, userId);
      if (existing) {
        error = 'Username already exists.';
      }
    }

    // Validate provider
    if (!error && !provider) {
      error = 'Provider is required.';
    }

    // Validate API key
    if (!error && !apiKey) {
      error = 'API Key is required.';
    }

    // Validate password if provided
    if (!error && password && password.length < 6) {
      error = 'Password must be at least 6 characters.';
    }

    // Update if no errors
    if (!error) {
      let updateFields = ['username = ?', 'provider = ?', 'api_key = ?', 'description = ?'];
      let updateValues: any[] = [newUsername, provider, apiKey, description || null];
      
      if (password) {
        const passwordHash = bcrypt.hashSync(password, 10);
        updateFields.push('password_hash = ?');
        updateValues.push(passwordHash);
      }
      
      updateValues.push(userId);
      db.prepare(`UPDATE dyndns_users SET ${updateFields.join(', ')} WHERE id = ?`)
        .run(...updateValues);
      success = 'Configuration saved successfully.';
      
      // Refresh user data
      user = db.prepare('SELECT * FROM dyndns_users WHERE id = ?').get(userId);
    }
  }

  if (action === 'add-domain') {
    const domain = (formData.get('domain') || '').toString().trim().toLowerCase();
    const initialIp = (formData.get('initialIp') || '').toString().trim();
    if (!domain || !initialIp) {
      error = 'Domain and initial IP are required.';
    } else {
      try {
        const provider = requireProvider(user.provider);
        const { zoneId, recordName, recordId, value, wasCreated } = await provider.ensureRRsetForDomain(user.api_key, domain, initialIp, 'A');
        
        db.prepare(`
          INSERT INTO domains (dyndns_user_id, domain, zone_id, record_name, record_id, last_ip, last_updated, app_created)
          VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        `).run(userId, domain, String(zoneId), recordName, recordId ? String(recordId) : null, value, new Date().toISOString(), wasCreated ? 1 : 0);
        success = `Domain added to ${currentProvider.displayName}${wasCreated ? ' (new record created)' : ' (existing record updated)'}.`;
      } catch (e) {
        error = e instanceof Error ? e.message : 'Failed to add domain';
      }
    }
  }

  if (action === 'delete-domain') {
    const domainId = Number(formData.get('domainId'));
    const deleteFromProvider = formData.get('deleteFromProvider') === 'on';
    if (domainId) {
      const domainRecord = db.prepare('SELECT * FROM domains WHERE id = ? AND dyndns_user_id = ?').get(domainId, userId) as Domain | undefined;
      
      if (domainRecord && deleteFromProvider) {
        try {
          const provider = requireProvider(user.provider);
          await provider.deleteRRset(
            user.api_key,
            domainRecord.zone_id,
            domainRecord.record_name,
            domainRecord.record_id,
            'A'
          );
          success = 'Domain removed from database and DNS provider.';
        } catch (e) {
          error = `Domain removed from database, but API deletion failed: ${e instanceof Error ? e.message : 'Unknown error'}`;
        }
      }
      
      db.prepare('DELETE FROM domains WHERE id = ? AND dyndns_user_id = ?').run(domainId, userId);
      if (!deleteFromProvider) {
        success = 'Domain removed from database.';
      }
    }
  }
  
  if (action === 'delete-user') {
    const confirmUsername = (formData.get('confirmUsername') || '').toString().trim();
    if (confirmUsername !== user.username) {
      error = 'Username confirmation does not match.';
    } else {
      db.prepare('DELETE FROM domains WHERE dyndns_user_id = ?').run(userId);
      db.prepare('DELETE FROM update_logs WHERE dyndns_user_id = ?').run(userId);
      db.prepare('DELETE FROM dyndns_users WHERE id = ?').run(userId);
      return Astro.redirect('/dashboard?success=User deleted');
    }
  }
}

// Refresh user after potential updates so UI shows latest values
user = db.prepare('SELECT * FROM dyndns_users WHERE id = ?').get(userId) as DynDnsUser;

const domains = db.prepare('SELECT * FROM domains WHERE dyndns_user_id = ? ORDER BY id DESC').all(userId) as Domain[];
---

<Layout title={`User: ${user.username}`}>
  <div class="page-container flex-col">
    <div class="page-header">
      <div>
        <a href="/dashboard" class="link-back">← Back</a>
        <h1 style="margin: 8px 0 4px 0;">{user.username}</h1>
        {user.description && <p class="text-muted" style="margin: 0 0 6px 0;">{user.description}</p>}
      </div>
      <div class="text-muted text-small" style="text-align: right;">
        <div>Created: {new Date(user.created_at).toLocaleDateString()}</div>
      </div>
    </div>

    {error && <div class="alert error">{error}</div>}
    {success && <div class="alert success">{success}</div>}

    <section class="card">
      <h3 style="margin-top: 0;">Basic Configuration</h3>
      <form method="post" class="form-grid">
        <input type="hidden" name="action" value="update-configuration" />
        
        <div>
          <h4 class="text-muted">User Credentials</h4>
          <div class="form-grid">
            <label class="input-label">
              Username
              <input name="username" value={user.username} required />
            </label>
            <label class="input-label">
              Password (leave blank to keep current)
              <input name="password" type="password" />
            </label>
          </div>
        </div>

        <div style="padding-top: 12px; border-top: 1px solid var(--border-color);">
          <h4 class="text-muted">DNS Provider Configuration</h4>
          <div class="form-grid">
            <label class="input-label">
              Provider
              <select name="provider" required>
                {providerOptions.map(opt => (
                  <option value={opt.value} selected={opt.value === user.provider}>{opt.label}</option>
                ))}
              </select>
            </label>
            <label class="input-label">
              API Key / Token
              <input name="apiKey" value={user.api_key || ''} required />
            </label>
            <label class="input-label">
              Description (optional)
              <input name="description" value={user.description || ''} />
            </label>
          </div>
        </div>

        <button type="submit" class="primary" style="width: fit-content; margin-top: 8px;">Save Configuration</button>
      </form>
    </section>

    <section class="card">
      <h3 style="margin-top: 0;">Domains</h3>
      <p class="text-muted" style="margin-top: 0;">Enter a domain and its initial IP address. Zone and record name will be resolved and stored read-only.</p>
      <form method="post" class="form-grid mb-2">
        <input type="hidden" name="action" value="add-domain" />
        <label class="input-label">
          Domain
          <input name="domain" placeholder="dyndns.example.com" required />
        </label>
        <label class="input-label">
          Initial IP Address (IPv4)
          <input name="initialIp" type="text" placeholder="192.168.1.1" required />
        </label>
        <button type="submit" class="secondary" style="width: fit-content;">Add domain</button>
      </form>

      {domains.length === 0 ? (
        <p class="text-muted">No domains yet.</p>
      ) : (
        <div class="flex-col" style="gap: 10px;">
          {domains.map(domain => (
            <form method="post" class="domain-item">
              <div class="domain-info">
                <div style="font-weight: 600;">{domain.domain}{domain.app_created ? ' *' : ''}</div>
                <div class="text-muted text-small">Zone ID: {domain.zone_id} • Record: {domain.record_name}{domain.record_id ? ` (ID: ${domain.record_id})` : ''}{domain.last_ip &&  ` • IP: ${domain.last_ip}`}</div>
                <div class="text-muted text-small">Update Endpoint: <code style="background: var(--card-bg); padding: 2px 4px; border-radius: 4px;">{Astro.url.origin}/nic/update?hostname={encodeURIComponent(domain.domain)}&myip=</code></div>
              </div>
              <div class="flex-col" style="align-items: flex-end; gap: 4px;">
                <input type="hidden" name="action" value="delete-domain" />
                <input type="hidden" name="domainId" value={domain.id} />
                {domain.app_created === 1 && (
                  <label class="text-small" style="margin-bottom:0px;">
                    <input type="checkbox" name="deleteFromProvider" />
                    Also delete from DNS provider
                  </label>
                )}
                <button type="submit" class="secondary" style="background: transparent;">Remove</button>
              </div>
            </form>
          ))}
        </div>
      )}
    </section>

    <section class="card">
      <h3 style="margin-top: 0; color: var(--color-danger);">Danger Zone</h3>
      <p class="text-muted" style="margin-top: 0;">Delete this DynDNS user and all associated domains and logs. This action cannot be undone. To confirm, enter the username below.</p>
      <form method="post" class="form-grid" style="padding-top: 12px; border-top: 1px solid var(--border-color);">
        <input type="hidden" name="action" value="delete-user" />
        <label class="input-label">
          Enter username to confirm deletion: <strong>{user.username}</strong>
          <input name="confirmUsername" placeholder={user.username} required />
        </label>
        <button type="submit" class="danger" style="width: fit-content;" onclick="return confirm('Are you sure? This will delete the user, all domains, and all logs.');">Delete User</button>
      </form>
    </section>
