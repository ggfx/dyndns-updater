---
import Layout from '../layouts/Layout.astro';
import { hasAdmin, getCurrentAdmin } from '../lib/auth.js';

export const prerender = false;

// Check if admin exists
const adminExists = hasAdmin();

// Check if already logged in
const currentAdmin = await getCurrentAdmin(Astro.request);

// Redirect based on state
if (currentAdmin) {
  return Astro.redirect('/dashboard');
}

if (!adminExists) {
  return Astro.redirect('/setup');
}

// Handle login form submission
let loginError = null;
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username');
    const password = formData.get('password');

    const { loginAdmin, setSessionCookie } = await import('../lib/auth.js');
    const result = await loginAdmin(username, password);

    if (result) {
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/dashboard',
          'Set-Cookie': setSessionCookie(result.sessionId),
        },
      });
    } else {
      loginError = 'Invalid username or password';
    }
  } catch (error) {
    console.error('Login error:', error);
    loginError = 'Login failed. Please try again.';
  }
}
---

<Layout title="Login">
  <div class="container" style="max-width: 400px; margin: 80px auto;">
    <h2>Login</h2>
    <p style="margin-bottom: 30px; opacity: 0.7;">Sign in to manage your DynDNS settings</p>

    {loginError && (
      <div class="alert error">{loginError}</div>
    )}

    <form method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autofocus />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>

      <button type="submit" style="width: 100%;">Login</button>
    </form>
  </div>
</Layout>

<style>
  .container {
    background: var(--card-bg);
    border-radius: 8px;
    padding: 40px;
    box-shadow: 0 2 8px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color);
  }

  h2 {
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
  }

  input {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--bg-color);
    color: var(--text-color);
  }

  input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  button {
    background: var(--color-primary);
    color: white;
    padding: 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
  }

  button:hover {
    opacity: 0.9;
  }

  .alert {
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
    border-left: 4px solid;
  }

  .alert.error {
    background-color: rgba(204, 0, 0, 0.1);
    color: #cc0000;
    border-color: #cc0000;
  }

  [data-theme="dark"] .alert.error {
    background-color: rgba(204, 0, 0, 0.2);
    color: #ff9999;
  }
</style>
