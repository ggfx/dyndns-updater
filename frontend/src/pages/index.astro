---
import Layout from '../layouts/Layout.astro';
import { hasAdmin, getCurrentAdmin } from '../lib/auth.js';

export const prerender = false;

// Check if admin exists
const adminExists = hasAdmin();

// Check if already logged in
const currentAdmin = await getCurrentAdmin(Astro.request);

// Redirect based on state
if (currentAdmin) {
  return Astro.redirect('/dashboard');
}

if (!adminExists) {
  return Astro.redirect('/setup');
}

// Handle login form submission
let loginError = null;
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username');
    const password = formData.get('password');

    const { loginAdmin, setSessionCookie } = await import('../lib/auth.js');
    const result = await loginAdmin(username, password);

    if (result) {
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/dashboard',
          'Set-Cookie': setSessionCookie(result.sessionId),
        },
      });
    } else {
      loginError = 'Invalid username or password';
    }
  } catch (error) {
    console.error('Login error:', error);
    loginError = 'Login failed. Please try again.';
  }
}
---

<Layout title="Login">
  <div class="container" style="max-width: 400px; margin: 80px auto;">
    <h2>Login</h2>
    <p class="text-muted mb-3">Sign in to manage your DynDNS settings</p>

    {loginError && (
      <div class="alert error">{loginError}</div>
    )}

    <form method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autofocus />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>

      <button type="submit" style="width: 100%;">Login</button>
    </form>
  </div>
</Layout>
