---
// 404 page
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not Found">
  <div class="page-container text-center" style="padding: 60px 30px;">
    <h1 style="font-size: 72px; margin-bottom: 20px;">404</h1>
    <h2>Page Not Found</h2>
    <p style="color: #666; margin: 20px 0;">Sorry, the page you're looking for doesn't exist.</p>
    <a href="/" class="btn-link">
      Go Home
    </a>
  </div>
</Layout>
