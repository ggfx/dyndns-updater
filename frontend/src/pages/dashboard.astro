---
import Layout from '../layouts/Layout.astro';
import { requireAdmin, clearSessionCookie } from '../lib/auth.js';
import { db } from '../lib/db.js';
import { getProviders } from '../lib/providers/index.js';

export const prerender = false;

interface DynDnsUser {
  id: number;
  username: string;
  provider: string;
  api_key: string;
  description: string | null;
  created_at: string;
  domain_count: number;
}

interface UpdateLog {
  id: number;
  dyndns_user_id: number;
  domain: string;
  ip: string;
  success: number;
  message: string | null;
  created_at: string;
}

let admin;
try {
  admin = await requireAdmin(Astro.request);
} catch (error) {
  return Astro.redirect('/');
}

// Handle logout via query param
if (Astro.url.searchParams.get('action') === 'logout') {
  const { logoutAdmin } = await import('../lib/auth.js');
  await logoutAdmin(Astro.request);
  return new Response(null, {
    status: 302,
    headers: {
      Location: '/',
      'Set-Cookie': clearSessionCookie(),
    },
  });
}

const dyndnsUsers = db.prepare(`
  SELECT du.*, COUNT(d.id) AS domain_count
  FROM dyndns_users du
  LEFT JOIN domains d ON du.id = d.dyndns_user_id
  GROUP BY du.id
  ORDER BY du.created_at DESC
`).all() as DynDnsUser[];

// Build provider lookup
const providers = getProviders();
const providerMap: Record<string, { name: string; displayName: string; apiKeyLabel: string }> = {};
providers.forEach(p => { providerMap[p.name] = p; });

// Get recent logs for each user (last 5 entries)
const userLogs: Record<number, UpdateLog[]> = {};
dyndnsUsers.forEach(user => {
  userLogs[user.id] = db.prepare(`
    SELECT * FROM update_logs
    WHERE dyndns_user_id = ?
    ORDER BY created_at DESC
    LIMIT 5
  `).all(user.id) as UpdateLog[];
});

// Check for success message in query params
const successMessage = Astro.url.searchParams.get('success');
---

<Layout title="Dashboard">
  <div class="page-container">
    <div class="page-header" style="align-items: flex-end;">
      <div>
        <h1>Dashboard</h1>
        <p class="text-muted">Manage DynDNS users, domains, and DNS provider API keys.</p>
      </div>
      <div class="flex-row mb-2">
        <span class="text-muted text-small">Signed in as <strong>{admin.username}</strong></span>
        <a href="/admin/edit" title="Edit profile" class="icon-btn">⚙️</a>
        <a href="?action=logout" class="btn-link-secondary">Logout</a>
      </div>
    </div>

    {successMessage && <div class="alert success mb-2">{successMessage}</div>}

    <div class="page-header">
      <h2>DynDNS Users</h2>
      <a href="/users/new" class="btn-link">+ Add DynDNS User</a>
    </div>

    {dyndnsUsers.length === 0 ? (
      <div class="card text-center" style="padding: 40px;">
        <p style="font-size: 18px; margin-bottom: 8px;">No DynDNS users yet.</p>
        <p class="text-muted mb-3">Create a user to configure credentials and domains.</p>
        <a href="/users/new" class="btn-link">Create DynDNS User</a>
      </div>
    ) : (
      <div class="flex-col">
        {dyndnsUsers.map(user => (
          <div class="user-card">
            <a href={`/users/${user.id}`} class="user-card-header">
              <div>
                <h3 style="margin: 0 0 6px 0; color: var(--color-primary);">{user.username}</h3>
                {user.description && <p class="text-muted" style="margin: 0 0 6px 0;">{user.description}</p>}
                <div class="user-meta">
                  <span>📍 {user.domain_count} {user.domain_count === 1 ? 'domain' : 'domains'}</span>
                  <span>☁️ {providerMap[user.provider]?.displayName || user.provider}</span>
                  <span>📅 {new Date(user.created_at).toLocaleDateString()}</span>
                </div>
              </div>
              <span style="color: var(--color-primary); font-size: 18px;">→</span>
            </a>

            {userLogs[user.id].length > 0 && (
              <div style="padding-top: 12px; border-top: 1px solid var(--border-color); margin-top: 12px;">
                <p class="text-xs text-muted" style="margin: 0 0 10px 0; font-weight: 600; text-transform: uppercase;">Recent Updates</p>
                <div class="flex-col" style="gap: 8px;">
                  {userLogs[user.id].map(log => (
                    <div class={`log-entry ${log.success ? 'success' : 'error'}`}>
                      <div style="display: flex; justify-content: space-between; gap: 8px;">
                        <div>
                          <strong>{log.domain}</strong> 
                          <span style="opacity: 0.8;">→ {log.ip}</span>
                        </div>
                        <span style="opacity: 0.7; white-space: nowrap;">{new Date(log.created_at).toLocaleTimeString()}</span>
                      </div>
                      {log.message && <div style="opacity: 0.8; margin-top: 4px;">{log.message}</div>}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
