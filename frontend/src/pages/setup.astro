---
import Layout from '../layouts/Layout.astro';
import { hasAdmin, createAdmin, setSessionCookie } from '../lib/auth.js';

export const prerender = false;

// If admin already exists, redirect to login
if (hasAdmin()) {
  return Astro.redirect('/');
}

// Handle setup form submission
let setupError = null;
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username');
    const password = formData.get('password');
    const confirmPassword = formData.get('confirmPassword');

    if (password !== confirmPassword) {
      setupError = 'Passwords do not match';
    } else if (password.length < 6) {
      setupError = 'Password must be at least 6 characters';
    } else {
      const result = await createAdmin(username, password);
      
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/dashboard',
          'Set-Cookie': setSessionCookie(result.sessionId),
        },
      });
    }
  } catch (error) {
    console.error('Setup error:', error);
    setupError = error.message || 'Setup failed. Please try again.';
  }
}
---

<Layout title="Initial Setup">
  <div class="container" style="max-width: 500px; margin: 80px auto;">
    <h2>Welcome to DynDNS Updater</h2>
    <p style="margin-bottom: 30px; opacity: 0.7;">
      No administrator account exists yet. Create your first admin account to get started.
    </p>

    {setupError && (
      <div class="alert error">{setupError}</div>
    )}

    <form method="POST">
      <div class="form-group">
        <label for="username">Admin Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          required 
          autofocus
          minlength="3"
          placeholder="Choose a username"
        />
        <small style="opacity: 0.7;">Min. 3 characters</small>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required
          minlength="6"
          placeholder="Choose a strong password"
        />
        <small style="opacity: 0.7;">Min. 6 characters</small>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          required
          minlength="6"
          placeholder="Repeat your password"
        />
      </div>

      <button type="submit" style="width: 100%;">Create Admin Account</button>
    </form>

    <div style="margin-top: 30px; padding: 20px; background: rgba(204, 180, 49, 0.1); border-radius: 4px; border-left: 4px solid var(--color-primary);">
      <strong>Note:</strong> This account will have full access to manage DynDNS users and settings.
    </div>
  </div>
</Layout>

<style>
  .container {
    background: var(--card-bg);
    border-radius: 8px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color);
  }

  h2 {
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
  }

  input {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--bg-color);
    color: var(--text-color);
    margin-bottom: 5px;
  }

  input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  small {
    font-size: 13px;
  }

  button {
    background: var(--color-primary);
    color: white;
    padding: 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
  }

  button:hover {
    opacity: 0.9;
  }

  .alert {
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
    border-left: 4px solid;
  }

  .alert.error {
    background-color: rgba(204, 0, 0, 0.1);
    color: #cc0000;
    border-color: #cc0000;
  }

  [data-theme="dark"] .alert.error {
    background-color: rgba(204, 0, 0, 0.2);
    color: #ff9999;
  }
</style>
