---
import Layout from '../layouts/Layout.astro';
import { hasAdmin, createAdmin, setSessionCookie } from '../lib/auth.js';

export const prerender = false;

// If admin already exists, redirect to login
if (hasAdmin()) {
  return Astro.redirect('/');
}

// Handle setup form submission
let setupError: string | null = null;
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = (formData.get('username') || '').toString().trim();
    const password = (formData.get('password') || '').toString().trim();
    const confirmPassword = (formData.get('confirmPassword') || '').toString().trim();

    if (!username || !password || !confirmPassword) {
      setupError = 'All fields are required';
    } else if (password !== confirmPassword) {
      setupError = 'Passwords do not match';
    } else if (password.length < 6) {
      setupError = 'Password must be at least 6 characters';
    } else if (username.length < 3) {
      setupError = 'Username must be at least 3 characters';
    } else {
      const result = await createAdmin(username, password);
      
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/dashboard',
          'Set-Cookie': setSessionCookie(result.sessionId),
        },
      });
    }
  } catch (error) {
    console.error('Setup error:', error);
    setupError = error instanceof Error ? error.message : 'Setup failed. Please try again.';
  }
}
---

<Layout title="Initial Setup">
  <div class="container" style="max-width: 500px; margin: 80px auto;">
    <h2>Welcome to DynDNS Updater</h2>
    <p class="text-muted mb-3">
      No administrator account exists yet. Create your first admin account to get started.
    </p>

    {setupError && (
      <div class="alert error">{setupError}</div>
    )}

    <form method="POST">
      <div class="form-group">
        <label for="username">Admin Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          required 
          autofocus
          minlength="3"
          placeholder="Choose a username"
        />
        <small class="text-small text-muted">Min. 3 characters</small>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required
          minlength="6"
          placeholder="Choose a strong password"
        />
        <small class="text-small text-muted">Min. 6 characters</small>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          required
          minlength="6"
          placeholder="Repeat your password"
        />
      </div>

      <button type="submit" style="width: 100%;">Create Admin Account</button>
    </form>

    <div style="margin-top: 30px; padding: 20px; background: rgba(204, 180, 49, 0.1); border-radius: 4px; border-left: 4px solid var(--color-primary);">
      <strong>Note:</strong> This account will have full access to manage DynDNS users and settings.
    </div>
  </div>
</Layout>
